{
  "expo": {
    "name": "BluePeso",
    "slug": "bluepeso",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.bluepeso.helper",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#11274a"
      },
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Choose payment QR images.",
          "savePhotosPermission": "Save a payment card PNG.",
          "granularPermissions": ["photo"]
        }
      ],
      "expo-sharing",
      "expo-router"
    ]
  }
}
